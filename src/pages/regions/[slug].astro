---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import FavoritesList from '../../components/FavoritesList.astro';
import { regions, visitors } from '../../lib/regions';
import { base } from '../../lib/match';

export function getStaticPaths() {
  return regions.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props as { r: (typeof regions)[number] };
const v = visitors(r.name);
---
<StarlightPage
  frontmatter={{
    title: `${r.name} 방문 손님`,
    description: `동방야작식당 ${r.name}에 오는 희귀·특별 손님 ${v.length}명과 손님별 추천 요리, 술 태그, 주문 멘트.`,
    tableOfContents: false,
  }}
>
  <p class="back"><a href={`${base}/`}>← 전체 손님 보기</a> · 지도에서 다른 지역 누르면 바로 이동</p>
  <FavoritesList only={r.name} />
</StarlightPage>
