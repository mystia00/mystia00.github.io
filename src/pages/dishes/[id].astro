---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AdSlot from '../../components/AdSlot.astro';
import { allDishes, dishName, dishIcon, portrait, fans, base, ingIcon, ingEn, custEn, customerLines, type Dish } from '../../lib/match';

export function getStaticPaths() {
  return allDishes.map((d) => ({ params: { id: d.id }, props: { dish: d } }));
}
const { dish } = Astro.props as { dish: Dish };
const name = dishName(dish);
const who = fans(dish);
const icon = dishIcon(dish);
const tagAnchor = (t: string) => `${base}/tags/food/#t-${t.replace(/\s+/g, '-')}`;
const custUrl = (n: string) => `${base}/customers/favorites/#c-${encodeURIComponent(n)}`;
---
<StarlightPage
  frontmatter={{
    title: name,
    description: `동방야작식당 ${name} 레시피: 재료 ${dish.ing.join(', ')} / ${dish.tool} / ${dish.price}엔. 태그와 좋아하는 손님.`,
    tableOfContents: false,
  }}
>
  <span hidden data-title-en={dish.en}></span>
  {!dish.ko && (
    <p class="note-unv">한국어 이름 확인 중. 영문 이름: <b>{dish.en}</b></p>
  )}

  <div class="recipe">
    <div class={`dicon big t-${['냄비','그릴','찜기','도마','팬'].indexOf(dish.tool)}`} aria-hidden="true">
      {icon ? <img src={icon} alt="" width="80" height="80" /> : name.slice(0, 2)}
    </div>
    <dl class="facts">
      <div><dt>가격</dt><dd class="num">{dish.price}엔</dd></div>
      <div><dt>레벨</dt><dd>{dish.lv}</dd></div>
      <div><dt>조리 도구</dt><dd>{dish.tool}</dd></div>
      <div><dt>수록</dt><dd>{dish.dlc}</dd></div>
    </dl>
  </div>

  <h2>재료</h2>
  <div class="ing-list">
    {dish.ing.map((i) => (
      <span class="ing-card">
        {ingIcon(i) ? <img src={ingIcon(i)!} alt="" width="36" height="36" /> : <span class="ing-ph" aria-hidden="true"></span>}
        <span data-en={ingEn(i)}>{i}</span>
      </span>
    ))}
  </div>

  <h2>요리 태그</h2>
  <p>{dish.tags.map((t) => <a class="chip like" href={tagAnchor(t)}>{t}</a>)}</p>
  {dish.ban.length > 0 && (
    <>
      <h3>추가 재료로 넣으면 안 되는 태그</h3>
      <p>{dish.ban.map((t) => <span class="chip dis">{t}</span>)}</p>
      <p class="hint">이 태그 붙은 재료를 추가하면 암흑물질 됨.</p>
    </>
  )}

  <h2>해금 방법</h2>
  <p>{dish.unlock}</p>

  <h2>좋아하는 손님</h2>
  {who.length ? (
    <div class="finder-scroll">
      <table class="tagidx">
        <thead><tr><th>손님</th><th class="num">맞는 태그</th><th>태그</th><th>이 요리로 받을 수 있는 주문</th></tr></thead>
        <tbody>
          {who.map((w) => (
            <tr>
              <td class="nm"><a class="who" href={custUrl(w.customer.name)}>{portrait(w.customer.name) && <img class="mini" src={portrait(w.customer.name)!} alt="" width="24" />}<span data-en={custEn(w.customer.name)}>{w.customer.name}</span></a></td>
              <td class="num">{w.hits.length}</td>
              <td>{w.hits.map((t) => <span class="chip like">{t}</span>)}</td>
              <td class="order">{customerLines(w.customer.name).filter(([, t]) => dish.tags.includes(t)).map(([l, t]) => <span class="ql">“{l}” <span class="chip like">{t}</span></span>)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : <p>선호 태그 2개 이상 맞는 손님 없음. 추가 재료로 태그 더해서 쓰기.</p>}

  <AdSlot />

  <p class="credit">레시피 데이터와 아이콘: <a href="https://touhou-mystias-izakaya.fandom.com/wiki/Cuisines">Touhou Mystia's Izakaya Wiki</a>. 게임 그림 권리는 개발사 二色幽紫蝶에 있음. 손님 매칭은 이 사이트 자체 계산. 주문 멘트: <a href="https://steamcommunity.com/sharedfiles/filedetails/?id=2912088261">스팀 가이드 (KGP XD)</a>.</p>
</StarlightPage>
