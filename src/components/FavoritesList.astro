---
// 손님별 추천 요리 (스타듀밸리 선물표처럼). only를 주면 그 지역 방문 손님만.
import DishTile from './DishTile.astro';
import RegionMap from './RegionMap.astro';
import DrinkTile from './DrinkTile.astro';
import drinks from '../data/drinks.json';
import { allCustomers, recommend, portrait, customerLines, customerUrl } from '../lib/match';
import { visitors } from '../lib/regions';
interface Props { only?: string }
const { only } = Astro.props;
const groups: [string, typeof allCustomers][] = only
  ? [[`${only} 방문 손님 ${visitors(only).length}명`, visitors(only)]]
  : [...new Set(allCustomers.map((c) => c.region))].map((r) => [r, allCustomers.filter((c) => c.region === r)]);
// 초상 자리에 넣을 짧은 이름 (서양식 이름은 앞, 일본식 이름은 뒤)
const western = ['리글 나이트버그', '앨리스 마가트로이드', '메디슨 멜랑콜리'];
const short = (n: string) => (n.includes(' ') ? (western.includes(n) ? n.split(' ')[0] : n.split(' ').pop()!) : n).slice(0, 3);
// 손님 술 태그를 많이 맞추는 술 (같으면 싼 것부터) 4개
const drinkRecs = (want: string[]) => drinks
  .map((d) => ({ d, s: d.tags.filter((t) => want.includes(t)).length }))
  .filter((x) => x.s > 0)
  .sort((a, b) => b.s - a.s || a.d.price - b.d.price)
  .slice(0, 4)
  .map((x) => x.d);
---
{!only && (
  <div class="fav-tools">
    <input type="search" class="fav-search" placeholder="손님 이름 검색" aria-label="손님 이름 검색" autocomplete="off" />
    <nav class="fav-jump" aria-label="지역 바로가기">{groups.map(([r]) => <a href={`#r-${r.replace(/\s+/g, '-')}`}>{r}</a>)}</nav>
  </div>
)}
<RegionMap current={only} />
{groups.map(([r, list]) => (
  <section class="fav-region">
    <h2 id={`r-${r.replace(/\s+/g, '-')}`}>{r}</h2>
    <div class="fav-list">
      {list.map((c) => {
        const recs = recommend(c, 6);
        return (
          <div class="fav-row" id={`c-${c.name}`}>
            <div class="fav-who">
              {portrait(c.name)
                ? <img class="portrait" src={portrait(c.name)!} alt="" width="56" height="56" loading="lazy" />
                : <span class="portrait" aria-hidden="true">{short(c.name)}</span>}
              <div>
                <a class="fav-name" href={customerUrl(c.name)}><b data-en={c.en}>{c.name}</b></a>
                <small>{c.dlc} · 예산 {c.budget}</small>
                <span class="who-tags">{c.like.map((t) => <span>{t}</span>)}</span>
                {((c as any).where ?? []).length > 0 && <small class="where">등장: {(c as any).where.join(', ')}</small>}
              </div>
            </div>
            <div class="fav-dishes">
              {c.like.length === 0 && <p class="fav-tbd">아직 선호 태그 정보가 없는 손님. 정리 중.</p>}
              {recs.length > 0 && <div class="tiles">{recs.map((x) => <DishTile dish={x.dish} who={c.name} />)}</div>}
              {c.drink.length > 0 && <div class="tiles drk-tiles">{drinkRecs(c.drink).map((d) => <DrinkTile drink={d} want={c.drink} />)}</div>}
              {c.drink.length > 0 && <p class="fav-drinks"><span>술</span>{c.drink.map((t) => <span class="chip drk">{t}</span>)}</p>}
              {customerLines(c.name).length > 0 && (
                <details class="orders" open>
                  <summary>주문 멘트 {customerLines(c.name).length}개</summary>
                  <ul>{customerLines(c.name).map(([l, t]) => <li>“{l}” <a class="chip like" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/dishes/?tag=${encodeURIComponent(t)}`}>{t}</a></li>)}</ul>
                </details>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>
))}

<p class="fav-none" hidden>검색 결과 없음</p>
<script>
  const box = document.querySelector<HTMLInputElement>('.fav-search');
  if (box) {
    const rows = [...document.querySelectorAll<HTMLElement>('.fav-row')];
    const secs = [...document.querySelectorAll<HTMLElement>('.fav-region')];
    const none = document.querySelector<HTMLElement>('.fav-none');
    const norm = (s: string) => s.toLowerCase().replace(/\s+/g, '');
    const key = (r: HTMLElement) => norm(r.id + ' ' + (r.querySelector('.fav-name')?.textContent || '') + ' ' + (r.querySelector('.fav-name b')?.getAttribute('data-en') || ''));
    box.addEventListener('input', () => {
      const q = norm(box.value);
      rows.forEach((r) => { r.hidden = !!q && !key(r).includes(q); });
      let any = false;
      secs.forEach((s) => { const v = s.querySelector('.fav-row:not([hidden])'); s.hidden = !v; if (v) any = true; });
      if (none) none.hidden = any;
      if (q) document.querySelector('.fav-region:not([hidden])')?.scrollIntoView({ block: 'start' });
    });
  }
</script>
