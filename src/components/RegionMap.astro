---
// 환상향 지도. 노란 지점에 마우스 올리면 그 지역 방문 손님, 누르면 그 지역 손님 페이지로 이동.
import { portrait, base } from '../lib/match';
import { regions, visitors, regionUrl } from '../lib/regions';
interface Props { current?: string }
const { current } = Astro.props;
const short = (n: string) => n.split(' ').pop()!;
---
<div class="rmap">
  <img class="rmap-img" src={`${base}/map.webp`} alt="환상향 지도" width="1400" height="887" />
  {regions.map(({ name: r, x, y }) => {
    const v = visitors(r);
    const rare = v.filter((c) => c.region === r);
    const sp = v.filter((c) => c.region !== r);
    const cls = ['spot', r === current ? 'on' : '', y < 40 ? 'below' : '', x > 75 ? 'left' : x < 22 ? 'right' : ''].join(' ');
    return (
      <a class={cls} style={`left:${x}%;top:${y}%`} href={regionUrl(r)} aria-label={`${r} 방문 손님 ${v.length}명`}>
        <span class="spot-ring"></span>
        <span class="spot-tip" aria-hidden="true">
          <b>{r} <span>방문 손님 {v.length}명</span></b>
          <span class="pin-faces">
            {rare.map((c) => (
              <span class="face">
                {portrait(c.name) ? <img src={portrait(c.name)!} alt="" width="36" height="36" loading="lazy" /> : <i></i>}
                <small data-en={c.en}>{short(c.name)}</small>
              </span>
            ))}
          </span>
          {sp.length > 0 && (
            <>
              <em>특별손님</em>
              <span class="pin-faces sp">
                {sp.map((c) => (
                  <span class="face">
                    {portrait(c.name) ? <img src={portrait(c.name)!} alt="" width="28" height="28" loading="lazy" /> : <i></i>}
                    <small data-en={c.en}>{short(c.name)}</small>
                  </span>
                ))}
              </span>
            </>
          )}
          <small class="spot-go">누르면 이 지역 손님만 보기</small>
        </span>
      </a>
    );
  })}
</div>
