---
// 요리 아이콘 칸. 누르면 레시피 상세, 마우스 올리면 재료 미리보기.
import { dishName, dishUrl, dishIcon, ingIcon, ingEn, quotes, portrait, type Dish } from '../lib/match';
interface Props { dish: Dish; size?: 'sm' | 'md'; label?: boolean }
const { dish, size = 'md', label = true } = Astro.props;
const name = dishName(dish);
const tool = dish.tool;
const icon = dishIcon(dish);
const qs = quotes(dish, 3);
---
<a class={`dtile ${size}`} href={dishUrl(dish)} aria-label={name}>
  <span class={`dicon t-${['냄비','그릴','찜기','도마','팬'].indexOf(tool)}`} aria-hidden="true">
    {icon ? <img src={icon} alt="" loading="lazy" width="48" height="48" /> : name.slice(0, 2)}
  </span>
  {label && <span class="dname"><span data-en={dish.en}>{name}</span>{!dish.ko && <em class="unv">영문</em>}</span>}
  <span class="tip" aria-hidden="true">
    <b data-en={dish.en}>{name}</b>
    <span class="tip-ing">
      {dish.ing.map((i) => (
        <span class="ing-item">
          {ingIcon(i) && <img src={ingIcon(i)!} alt="" loading="lazy" width="20" height="20" />}
          <span data-en={ingEn(i)}>{i}</span>
        </span>
      ))}
    </span>
    <small>{dish.price}엔 · {tool}</small>
    {qs.length > 0 && (
      <span class="tip-q">
        {qs.map((q) => (
          <span class="q">
            {portrait(q.customer.name) && <img src={portrait(q.customer.name)!} alt="" loading="lazy" width="20" height="20" />}
            <span><b data-en={q.customer.en}>{q.customer.name}</b> “{q.line}” <em>{q.tag}</em></span>
          </span>
        ))}
      </span>
    )}
  </span>
</a>
